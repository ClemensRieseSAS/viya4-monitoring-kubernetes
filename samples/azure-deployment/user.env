# Auto-generate access to the web applications via Contour HTTPProxy resources
# Requires Contour (CRD httpproxies.projectcontour.io) in the cluster.
# INGRESS_TYPE must be set explicitly; the default is ingress-nginx.
# See samples/contour for manual HTTPProxy configuration.
AUTOGENERATE_INGRESS=true
INGRESS_TYPE=contour
# path: https://monitoring.<BASE_DOMAIN>/grafana, https://logging.<BASE_DOMAIN>/dashboards
# host: https://grafana.<BASE_DOMAIN>, https://dashboards.<BASE_DOMAIN>
ROUTING=path
BASE_DOMAIN=host.cluster.example.com
#
# Optional TLS certificate and key for the generated HTTPProxy resources
# INGRESS_CERT=/path/to/tls.crt
# INGRESS_KEY=/path/to/tls.key
#
# Optional access to unauthenticated web applications (default: false)
# PROMETHEUS_INGRESS_ENABLE=true
# ALERTMANAGER_INGRESS_ENABLE=true
# OPENSEARCH_INGRESS_ENABLE=true
